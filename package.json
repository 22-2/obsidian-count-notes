{
	"name": "obsidian-count-novels",
	"type": "module",
	"version": "1.0.0",
	"description": "This is a sample plugin for Obsidian (https://obsidian.md)",
	"main": "main.js",
	"scripts": {
		"dev": "pnpm dlx tsx esbuild.config.mts",
		"build": "pnpm dlx tsx esbuild.config.mts production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"check-types": "tsc -noEmit -skipLibCheck",
		"repomix": "pnpm dlx repomix && code ./repomix-output.md",
		"test:e2e": "playwright test",
		"test:e2e:example": "pnpm playwright test e2e/specs/setup/example.spec.ts --project=chromium",
		"test:e2e:data-collection": "pnpm playwright test e2e/specs/data-collection.spec.ts --project=chromium",
		"test:e2e:debug": "cross-env DEBUG=pw:api playwright test"
	},
	"keywords": [],
	"author": "",
	"license": "MIT",
	"devDependencies": {
		"@biomejs/biome": "2.2.4",
		"@electron/asar": "^4.0.1",
		"@playwright/test": "^1.55.1",
		"@types/chart.js": "^4.0.1",
		"@types/node": "24.6.2",
		"builtin-modules": "5.0.0",
		"dotenv": "^17.2.3",
		"electron": "^38.2.0",
		"esbuild": "0.25.10",
		"loglevel-plugin-prefix": "^0.8.4",
		"obsidian": "^1.10.0",
		"obsidian-typings": "4.58.0",
		"playwright": "^1.55.1",
		"tiny-invariant": "^1.3.3",
		"tslib": "^2.8.1",
		"typescript": "5.9.3"
	},
	"dependencies": {
		"chalk": "^5.6.2",
		"chart.js": "^4.5.0",
		"loglevel": "^1.9.2",
		"zod": "^4.1.11"
	}
}
