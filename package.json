{
    "name": "obsidian-count-novels",
    "version": "1.0.0",
    "description": "This is a sample plugin for Obsidian (https://obsidian.md)",
    "main": "main.js",
    "scripts": {
        "dev": "pnpm dlx tsx esbuild.config.mts",
        "build": "pnpm dlx tsx esbuild.config.mts production",
        "version": "node version-bump.mjs && git add manifest.json versions.json",
        "check-types": "tsc -noEmit -skipLibCheck",
        "repomix": "pnpm dlx repomix && code ./repomix-output.md",
        "setup-symlink": "node scripts/setup-symlink.mjs",
        "rename-plugin": "node scripts/rename-plugin.mjs"
    },
    "keywords": [],
    "author": "",
    "license": "MIT",
    "devDependencies": {
        "@biomejs/biome": "2.2.4",
        "@types/chart.js": "^4.0.1",
        "@types/node": "24.6.2",
        "builtin-modules": "5.0.0",
        "dotenv": "^17.2.3",
        "esbuild": "0.25.10",
        "obsidian": "^1.10.0",
        "obsidian-typings": "4.58.0",
        "tslib": "^2.8.1",
        "typescript": "5.9.3"
    },
    "dependencies": {
        "chart.js": "^4.5.0"
    }
}
