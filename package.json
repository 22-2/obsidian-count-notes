{
	"name": "obsidian-count-novels",
	"type": "module",
	"version": "1.0.0",
	"description": "This is a sample plugin for Obsidian (https://obsidian.md)",
	"main": "main.js",
	"scripts": {
		"dev": "pnpm dlx tsx esbuild.config.mts",
		"build": "pnpm dlx tsx esbuild.config.mts production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"check-types": "tsc -noEmit -skipLibCheck",
		"repomix": "pnpm dlx repomix && code ./repomix-output.md",
		"test": "vitest",
		"test:watch": "vitest --watch",
		"test:e2e": "playwright test",
		"test:coverage": "vitest --coverage"
	},
	"keywords": [],
	"author": "",
	"license": "MIT",
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@electron/asar": "^4.0.1",
		"@playwright/test": "1.56.0",
		"@types/chart.js": "^4.0.1",
		"@types/node": "24.10.1",
		"@vitest/coverage-v8": "^4.0.8",
		"builtin-modules": "5.0.0",
		"dotenv": "^17.2.3",
		"electron": "^39.1.2",
		"esbuild": "0.27.0",
		"fake-indexeddb": "^6.2.5",
		"loglevel-plugin-prefix": "^0.8.4",
		"obsidian": "^1.10.3",
		"obsidian-typings": "4.63.0",
		"playwright": "1.56.0",
		"tiny-invariant": "^1.3.3",
		"tslib": "^2.8.1",
		"typescript": "5.9.3",
		"vite-tsconfig-paths": "^5.1.4",
		"vitest": "^4.0.8"
	},
	"dependencies": {
		"chalk": "^5.6.2",
		"chart.js": "^4.5.1",
		"chartjs-plugin-annotation": "^3.1.0",
		"dexie": "^4.2.1",
		"idb-keyval": "^6.2.2",
		"loglevel": "^1.9.2",
		"obsidian-e2e-toolkit": "git+https://github.com/22-2/obsidian-e2e-toolkit.git",
		"zod": "^4.1.12"
	}
}
